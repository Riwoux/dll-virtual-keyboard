# EditorConfig helps maintain consistent coding styles
# https://editorconfig.org/

root = true

# All files
[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
trim_trailing_whitespace = true

# C++ source files
[*.{cpp,h,c,hpp,cc,cxx}]
indent_style = space
indent_size = 4
tab_width = 4

# C++ Builder specific files
[*.{dfm,pas,dpr,dpk}]
indent_style = space
indent_size = 2

# Project files
[*.{cbproj,groupproj,dproj}]
indent_style = space
indent_size = 2

# Markdown files
[*.md]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false

# JSON files
[*.json]
indent_style = space
indent_size = 2

# XML files
[*.xml]
indent_style = space
indent_size = 2

# YAML files
[*.{yml,yaml}]
indent_style = space
indent_size = 2

# Batch and shell scripts
[*.{bat,cmd}]
end_of_line = crlf

[*.sh]
end_of_line = lf

# Makefiles
[Makefile]
indent_style = tab

# Configuration files
[*.{ini,conf,config}]
indent_style = space
indent_size = 4
